# Radar: elenco delle variabili d'ambiente (SOLO i nomi, mai i valori veri).
# Copia questo file in ".env.local" e compila i valori. ".env.local" non va mai su git.
# Gli stessi nomi vanno inseriti anche su Vercel (Settings > Environment Variables)
# e su GitHub (Settings > Secrets and variables > Actions), come spiegato in CLAUDE.md.

# --- Database (Supabase) --- Fase 1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Account utente (Supabase Auth) --- Fase 1
# L'indirizzo è lo stesso di SUPABASE_URL (viene ripreso da solo).
# La chiave "anon" (o "publishable") è pubblica per natura: Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Notifiche push (VAPID) --- Fase 2
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Formato obbligatorio per Apple: mailto:indirizzo@dominio.it (niente spazi, niente < >)
VAPID_SUBJECT=

# --- API di Claude (riassunti) --- fase successiva, facoltativa
ANTHROPIC_API_KEY=
